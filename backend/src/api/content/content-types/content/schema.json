{
  "kind": "collectionType",
  "collectionName": "contents",
  "info": {
    "singularName": "content",
    "pluralName": "contents",
    "displayName": "Content"
  },
  "options": {
    "draftAndPublish": true
  },
  "config": {
    "attributes": {
      "video_path": { "hidden": true }
    }
  },
  "attributes": {
    "content_name": {
      "type": "string",
      "required": true
    },
    "tutorial_text": {
      "type": "text",
      "required": true
    },
    "subject": {
      "type": "string",
      "required": true
    },
    "grade": {
      "type": "integer",
      "required": true,
      "min": 0,
      "max": 4
    },
    "video_path": {
      "type": "string"
    },
    "video": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["videos"]
    }
  }
}
